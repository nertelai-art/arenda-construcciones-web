# --- Demo per a un lead (src/demo-kit) ---
# Amb DEMO_SECRET i DEMO_SITE, només s'entra amb un enllaç personal; la resta veu la pàgina de
# bloqueig de Nertel. Sense, la web és oberta. Es treuen quan la web passa a ser la del client.
# Secret per signar els enllaços (SECRET: només a Vercel i a .env.local, mai al repositori).
DEMO_SECRET=
# Identificador de la web als enllaços i a PostHog (arenda-construcciones).
DEMO_SITE=
# Adreça pública de la demo, per a l'ordre que fa els enllaços (pnpm demo:link).
DEMO_URL=
# Leads amb l'enllaç anul·lat, separats per comes (p. ex. quality-constructions).
DEMO_REVOKED=
# Webhook que rep un avís quan un lead obre la demo en un navegador nou (n8n, Slack…). Opcional.
DEMO_NOTIFY_URL=

# PostHog (núvol de la UE), el mateix projecte per a totes les demos. La clau de projecte és pública.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
